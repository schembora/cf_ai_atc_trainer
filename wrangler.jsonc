{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-atc-trainer",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "PilotAgent", "class_name": "PilotAgent" }]
  },
  "workflows": [
    {
      "name": "atc-briefing",
      "binding": "BRIEFING_WORKFLOW",
      "class_name": "BriefingWorkflow"
    },
    {
      "name": "atc-debrief",
      "binding": "DEBRIEF_WORKFLOW",
      "class_name": "DebriefWorkflow"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PilotAgent"] }]
}
